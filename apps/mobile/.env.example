# Trezo Wallet Environment Configuration
# =========================================
# Copy this file to `.env` and fill in your own values before running the app.

# =========================================
# Supabase Configuration
# =========================================
# Get these from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-anon-key

# =========================================
# Moralis Data API
# =========================================
# Get your API key from: https://admin.moralis.io/settings/api-keys
MORALIS_API_KEY=your-moralis-data-api-key

# =========================================
# LI.FI Aggregator (mainnet swap + cross-chain routing — FR-06 / FR-07, ADR 0014)
# =========================================
# Used ONLY on mainnet network keys (base-mainnet, base-mainnet-fork). The free
# tier works with NO key; a key only raises rate limits (https://li.fi partner portal).
EXPO_PUBLIC_LIFI_API_KEY=
EXPO_PUBLIC_LIFI_INTEGRATOR=trezo

# =========================================
# Passkey Configuration (WebAuthn)
# =========================================
# Relying Party ID - MUST be a real domain you own
# Examples: your-domain.com OR username.github.io
# Requires .well-known/assetlinks.json (Android) and apple-app-site-association (iOS)
EXPO_PUBLIC_PASSKEY_RP_ID=your-domain.com
EXPO_PUBLIC_PASSKEY_RP_NAME="Your Wallet Name"

# =========================================
# Default chain
# =========================================
# Which chain the wallet starts on. Set to 31337 for Anvil local dev.
# Valid values: 31337 (Anvil), 11155111 (Sepolia), 84532 (Base Sepolia), 421614 (Arb Sepolia)
# Chain must be enabled (deployment manifest + RPC/bundler vars present) or the app falls back to Anvil.
EXPO_PUBLIC_DEFAULT_CHAIN_ID=31337

# =========================================
# RPC URLs
# =========================================
# Ethereum Sepolia Testnet
# Get free RPC from: https://www.quicknode.com or https://alchemy.com
EXPO_PUBLIC_SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY
# Pimlico bundler + paymaster (single key for all 3 testnets via dashboard.pimlico.io)
EXPO_PUBLIC_SEPOLIA_BUNDLER_URL=https://api.pimlico.io/v2/sepolia/rpc?apikey=YOUR_PIMLICO_KEY
EXPO_PUBLIC_SEPOLIA_PAYMASTER_URL=https://api.pimlico.io/v2/sepolia/rpc?apikey=YOUR_PIMLICO_KEY
# Legacy contract-address env vars (now read from deployment manifest; kept as fallback):
EXPO_PUBLIC_SEPOLIA_ENTRYPOINT=0x0000000000000000000000000000000000000000
EXPO_PUBLIC_SEPOLIA_ACCOUNT_FACTORY=0x0000000000000000000000000000000000000000
EXPO_PUBLIC_SEPOLIA_PROXY_FACTORY=
EXPO_PUBLIC_SEPOLIA_ACCOUNT_IMPL=
EXPO_PUBLIC_SEPOLIA_PASSKEY_VALIDATOR=

# Base Sepolia Testnet
EXPO_PUBLIC_BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
EXPO_PUBLIC_BASE_SEPOLIA_BUNDLER_URL=https://api.pimlico.io/v2/base-sepolia/rpc?apikey=YOUR_PIMLICO_KEY
EXPO_PUBLIC_BASE_SEPOLIA_PAYMASTER_URL=https://api.pimlico.io/v2/base-sepolia/rpc?apikey=YOUR_PIMLICO_KEY
# Optional: enables on-chain asset-change simulation for dApp tx requests (graceful no-op if unset)
# Get a free key at https://alchemy.com
# EXPO_PUBLIC_BASE_SEPOLIA_ALCHEMY_URL=https://base-sepolia.g.alchemy.com/v2/YOUR_API_KEY

# Arbitrum Sepolia Testnet
EXPO_PUBLIC_ARB_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc
EXPO_PUBLIC_ARB_SEPOLIA_BUNDLER_URL=https://api.pimlico.io/v2/arbitrum-sepolia/rpc?apikey=YOUR_PIMLICO_KEY
EXPO_PUBLIC_ARB_SEPOLIA_PAYMASTER_URL=https://api.pimlico.io/v2/arbitrum-sepolia/rpc?apikey=YOUR_PIMLICO_KEY

# Local Anvil (for development)
EXPO_PUBLIC_ANVIL_RPC_URL=http://localhost:8545
# Anvil bundler + paymaster default to localhost:4337 / localhost:3000 — override only if non-standard
# EXPO_PUBLIC_ANVIL_BUNDLER_URL=http://localhost:4337
# EXPO_PUBLIC_ANVIL_PAYMASTER_URL=http://localhost:3000

# Ethereum Mainnet (Optional)
# EXPO_PUBLIC_MAINNET_RPC_URL=https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY

# zkSync Era Mainnet (Optional)
# EXPO_PUBLIC_ZKSYNC_MAINNET_RPC_URL=https://mainnet.era.zksync.io

# zkSync Sepolia Testnet (Optional)
# EXPO_PUBLIC_ZKSYNC_SEPOLIA_RPC_URL=https://sepolia.era.zksync.dev

# =========================================
# Development Settings
# =========================================
# Enable Supabase debugging logs (optional)
# SUPABASE_LOG_LEVEL=debug

# =========================================
# Email Recovery — ZK Email Relayer
# =========================================
# ZK Email hosted relayer URL. Sends/receives guardian emails and generates ZK proofs.
# The hosted relayer is available on Base Sepolia (chain 84532).
#
# For testnet (Base Sepolia), use the ZK Email staging relayer:
EXPO_PUBLIC_ZK_EMAIL_RELAYER_URL=https://auth-base-sepolia-staging.prove.email/api
# Optional API key for the ZK Email relayer (if required by your deployment):
# EXPO_PUBLIC_ZK_EMAIL_RELAYER_API_KEY=
# Proof mode: per_chain_hosted (one proof per guardian per chain) or reusable (one proof per guardian):
EXPO_PUBLIC_ZK_EMAIL_PROOF_MODE=per_chain_hosted
# Template indices: both MUST be 0 on the canonical EmailRecoveryCommandHandler.
# Any other value reverts on-chain with InvalidTemplateIndex
# (see contracts/lib/email-recovery/src/handlers/EmailRecoveryCommandHandler.sol).
EXPO_PUBLIC_ZK_EMAIL_ACCEPTANCE_TEMPLATE_IDX=0
EXPO_PUBLIC_ZK_EMAIL_RECOVERY_TEMPLATE_IDX=0
#
# For local Anvil development (no hosted relayer), opt in to the in-memory mock:
# EXPO_PUBLIC_ZK_EMAIL_USE_MOCK=true
# (App will refuse to start a recovery flow if the relayer URL is missing
#  AND USE_MOCK is not set, to prevent silent mock usage in production builds.)
#
# ZK Email deployed contracts on Base Sepolia (for reference):
#   EmailRecoveryUniversalFactory: 0x5d50382D2f1C94268b784A69c99DEA7F6Babd2E6
#   UniversalEmailRecoveryModule:  0x636632FA22052d2a4Fb6e3Bab84551B620b9C1F9
#   RecoveryController Proxy:      0xBBaE39b5Cd43C02BF7418bf2B21133780c84a355

# =========================================
# Guardian Approval Web App
# =========================================
# Public URL where the guardian-approval web app is hosted (apps/guardian-approval).
# Guardians click this link to review and sign recovery requests.
# Production default points to the Vercel deployment.
EXPO_PUBLIC_GUARDIAN_PORTAL_URL=https://guardian-approval.vercel.app

# =========================================
# Discover — News feed
# =========================================
# No token needed. News is served by the `news` Supabase edge function, which
# aggregates free public RSS feeds server-side and adds CORS (so it works on
# Expo web too). Deploy it with: supabase functions deploy news
# The section hides itself automatically if the feed returns nothing.

# CoinGecko Demo API key (free: 100 calls/min, 10k/month). https://www.coingecko.com/en/api
EXPO_PUBLIC_COINGECKO_API_KEY=
